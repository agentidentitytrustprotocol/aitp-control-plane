{
  // Fail CI on high (and critical) advisories in PRODUCTION dependencies.
  // Moderate/low advisories in transitive deps don't block merges — they
  // are handled by the weekly Dependabot updates instead.
  "high": true,
  "skip-dev": true,
  "report-type": "important",

  // Documented, reviewed exceptions. Each entry MUST have a reason and,
  // ideally, a tracking path to removal. Re-audit these whenever the
  // OpenTelemetry deps are bumped.
  //
  // Currently empty — and that is the desired steady state. An advisory
  // that can be fixed should be fixed (see the `overrides` block in
  // package.json) rather than allowlisted here.
  //
  // Removed 2026-08-25: GHSA-q7rr-3cgh-j5r3 ("Prometheus exporter process
  // crash via malformed HTTP request" in @opentelemetry/{auto-
  // instrumentations-node, sdk-node}). Its own comment named the exit
  // condition — "the only fix is a semver-major OTel bump" — and that bump
  // landed in #50, taking sdk-node to 0.221.0 and
  // auto-instrumentations-node to 0.79.0. `npm audit` no longer reports the
  // advisory against any package, and audit-ci had begun emitting
  // "Consider not allowlisting advisory: GHSA-q7rr-3cgh-j5r3" because the
  // entry matched nothing. A stale entry is worse than no entry: it would
  // silently re-suppress the advisory if a future dependency reintroduced
  // it, with no one having decided that.
  "allowlist": []
}
