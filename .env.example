# Server
PORT=4000
# Public origin embedded in the CP's own manifest. Note: the manifest advertises
# <CP_BASE_URL>/api/aitp/handshake/hello, a route this service does not serve.
CP_BASE_URL=http://localhost:4000

# Every production safeguard keys on NODE_ENV being exactly `production` (after
# trimming): fail-closed API_KEYS, the fatal ENROLLMENT_SECRET boot check, the
# CP_AID_SEED_HEX requirement, https-only webhooks, JSON logs. Any other value
# (or unset) runs as NOT production and logs an error-level warning at boot
# unless it is `development` or `test`. The image sets NODE_ENV=production, and
# `next start` / `next dev` set it themselves, so leave it unset locally.
# NODE_ENV=production

# CP identity — REQUIRED in production. Outside production an unset seed is
# replaced by a random one on every boot (the AID changes on restart). In
# production it is not checked at boot: the first use throws, so /api/health,
# the manifest and the revocation list answer 500 until it is set. Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CP_AID_SEED_HEX=

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aitp_control_plane
DB_POOL_MAX=20

# API key list (comma-separated). Empty = auth disabled.
# REQUIRED in production (NODE_ENV=production) — admin endpoints like
# /api/webhooks, /api/audit, and DELETE /api/registry/agents/:aid will
# 503 if this is unset in prod, to prevent accidental public exposure.
API_KEYS=

# Enrollment token signing secret (REQUIRED, >= 32 chars). Unset or too short
# takes out both POST /api/registry/enroll and POST /api/registry/agents — one
# cannot mint tokens, the other cannot verify them.
#
# Validated at boot, and what happens next depends on NODE_ENV:
#   NODE_ENV=production — FATAL. The process prints one line and exits 1, so a
#     bad value fails the deploy instead of deploying green. This is every
#     container deploy (the image sets NODE_ENV=production) AND a local
#     `npm start`, because `next start` defaults NODE_ENV to production.
#   anything else, `npm run dev` included — the same line is printed as a
#     warning and the server starts. Leaving this empty is fine if you are not
#     exercising enrollment; the two routes above then answer
#     503 SERVER_MISCONFIGURED for every request.
# /api/readyz deliberately does not check it (see
# docs/operations.md#what-apireadyz-deliberately-does-not-check).
# Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENROLLMENT_SECRET=

# CORS origin — REQUIRED in production. Set to the UI plane origin.
# Defaults to http://localhost:3000 if unset (including in production).
CORS_ORIGIN=http://localhost:3000

# ── Multi-tenancy note ───────────────────────────────────────────────
# `GET /api/registry/agents` without `?namespace=` returns rows across
# ALL namespaces by design (registry discovery is an operational,
# non-normative layer in AITP — not a protocol isolation boundary). If you
# rely on per-tenant isolation, your caller MUST set
# `?namespace=<tenant>` on discovery and `X-Aitp-Namespace: <tenant>`
# on enrollment. The CP enforces no implicit tenancy boundary.

# Revocation list TTL (seconds)
REVOCATION_LIST_TTL_SECS=3600

# What the revocation list does when the DB read fails. The CP never signs an
# empty list from a failed read (that would assert "nothing is revoked").
#   fail_closed (default) - 503 REVOCATION_UNAVAILABLE
#   serve_stale           - re-serve the last list backed by a successful read,
#                           for at most REVOCATION_MAX_STALENESS_SECS, then 503
# Anything else is treated as fail_closed.
REVOCATION_FAIL_MODE=fail_closed
# serve_stale only; clamped to REVOCATION_LIST_TTL_SECS.
REVOCATION_MAX_STALENESS_SECS=300

# Webhook retry attempts (per delivery)
WEBHOOK_RETRY_ATTEMPTS=3

# Webhook circuit breaker: consecutive failures before the breaker opens,
# and how long it stays open before a half-open probe is allowed (ms).
WEBHOOK_BREAKER_FAILURE_THRESHOLD=5
WEBHOOK_BREAKER_RESET_MS=60000

# Optional SSRF allowlist for webhook target hosts. Comma-separated.
# Empty = any PUBLIC host is allowed (private/loopback/link-local ranges
# are always rejected). An entry beginning with "." matches the apex and
# any subdomain (e.g. ".example.com" matches example.com and a.example.com).
# WEBHOOK_URL_ALLOWLIST=.hooks.example.com,events.partner.com

# SSE backlog size (in-memory)
MAX_AUDIT_EVENTS_MEMORY=500

# Maximum concurrent /api/events/stream connections per process.
# 503 SSE_CAPACITY is returned above this; clients should back off and retry.
MAX_SSE_CONNECTIONS=500

# Interval between `: heartbeat` keepalive frames on an open SSE stream, and the
# `retry:` reconnect hint the stream advertises at connect. Default 15000.
# Keep it BELOW your edge's idle timeout (commonly 30-60s) or idle streams get
# dropped between beats. Clamped to 1000-2147483647ms, at both ends for the same
# reason: 0/negative values are accepted by the parser, and anything past 2^31-1
# overflows setInterval, and in BOTH cases Node ends up firing ~every millisecond
# on every open stream. Read once at boot, so a change needs a restart.
SSE_HEARTBEAT_MS=15000

# Logging. Default: info under NODE_ENV=production, debug otherwise (pretty-
# printed via pino-pretty outside production).
LOG_LEVEL=info

# ── OpenTelemetry (disabled by default) ──────────────────────────────
# Set OTEL_ENABLED=true to enable. Spans go over OTLP/HTTP to
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, else OTEL_EXPORTER_OTLP_ENDPOINT. The CP
# passes whichever is set to the exporter as its FULL URL, so /v1/traces is NOT
# appended — include it. With neither set: http://localhost:4318/v1/traces.
# Auto-instruments HTTP, pg, fetch, etc.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aitp-control-plane
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Read by the OpenTelemetry SDK itself (not by CP code): enables its diagnostic
# logger, e.g. `debug` to see instrumentation patching at startup.
# OTEL_LOG_LEVEL=debug

# ── Rate limiting (requests per minute, in-memory per-process) ───────
# Set any limit to 0 to disable that bucket. Set RATE_LIMIT_ENABLED=false
# to disable the limiter entirely (useful in dev / load tests).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ENROLLMENT_PER_IP_MIN=5
RATE_LIMIT_PUBLIC_PER_IP_MIN=60
RATE_LIMIT_API_KEY_PER_MIN=600
# Window over which the per-min limits accumulate. Default 60s matches the
# bucket-name "per-min" semantics; bump to e.g. 5m for smoother averaging.
RATE_LIMIT_WINDOW_MS=60000
# Client-IP resolution for rate limiting. X-Forwarded-For is
# client-controllable, so by default (TRUSTED_PROXY_HOPS=0) it is NOT
# trusted — set these to match your edge or per-IP limits are spoofable.
#   CLIENT_IP_HEADER: a single trusted header your edge sets to the real
#     client IP. Takes precedence when set.
#   TRUSTED_PROXY_HOPS: number of trusted proxies appending to XFF; the
#     client IP is read that many entries from the RIGHT of the header.
# CLIENT_IP_HEADER=x-vercel-forwarded-for
TRUSTED_PROXY_HOPS=0

# ── Trust-anchor JWKS cache refresh ──────────────────────────────────
# Background job that caches each OIDC trust anchor's JWKS (explicit
# jwks_url, else OIDC discovery) for GET /api/trust-anchors/:id/jwks.
# Fetches are SSRF-guarded (public addresses only, no redirects, 1 MiB cap).
JWKS_REFRESH_ENABLED=true
JWKS_REFRESH_INTERVAL_MS=900000
JWKS_STALE_AFTER_MS=3600000
JWKS_FETCH_TIMEOUT_MS=10000

# ── Observed-artifact verification ───────────────────────────────────
# Agents REPORT TCTs/delegations; the CP projects them. When a report carries
# the full signed token ({ token, claims }), verify it first.
#   off    — never verify (default)
#   warn   — verify, log failures, project anyway
#   strict — project only reports whose token verifies (drops claims-only
#            reports and expired/tampered tokens)
OBSERVED_ARTIFACT_VERIFICATION=off

# ── Data retention sweep ─────────────────────────────────────────────
# Periodically deletes old audit events, terminal webhook deliveries,
# admin audit log entries, and long-deregistered agents. Multi-instance
# safe via a Postgres advisory lock. Set any TTL to 0 to keep that
# table indefinitely. Started lazily by a process's first POST /api/events,
# not at boot (see docs/operations.md#data-retention).
RETENTION_ENABLED=true
RETENTION_INTERVAL_MS=1800000
AUDIT_EVENTS_TTL_DAYS=90
WEBHOOK_DELIVERY_TTL_DAYS=14
EXPIRED_AGENT_GRACE_DAYS=30
ADMIN_AUDIT_TTL_DAYS=365
IDEMPOTENCY_KEY_TTL_DAYS=7
RETENTION_BATCH_LIMIT=10000
